# dependencies
node_modules/
.npm-cache/
.corepack/

# build output
dist/
build/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# PHI — never commit. Real dictations, gold labels, filled charts.
# ---------------------------------------------------------------------------
samples/
eval/gold/
out/
logs/

# ---------------------------------------------------------------------------
# Large binary assets. Fetched by `ophtha-scribe assets fetch`, kept on-disk
# beside the repo (never on C:), never in git.
# ---------------------------------------------------------------------------
assets/models/*
!assets/models/.gitkeep
assets/bin/*
!assets/bin/.gitkeep
assets/form/*
!assets/form/.gitkeep
!assets/form/field-manifest.json

# local config / secrets
.env
.env.local
*.local.json

# editor / os
.vscode/
.idea/
.DS_Store
Thumbs.db
